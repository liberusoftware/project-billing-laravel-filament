includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    # Analyse host-owned source. Published modules and themes are Composer output — analysing them from
    # here uses the host's resolution rather than the package's own, and the
    # package is the only place its source can be analysed against the tree a
    # consumer actually installs. Each package carries its own measured level in
    # its tests.yml, as the reusable workflow's phpstan-level input.
    paths:
        - modules/billing-application/src/
        - modules/billing-audit/src/
        - modules/billing-catalog/src/
        - modules/billing-collections/src/
        - modules/billing-communications/src/
        - modules/billing-customer-portal/src/
        - modules/billing-domains/src/
        - modules/billing-extensions/src/
        - modules/billing-filament/src/
        - modules/billing-files/src/
        - modules/billing-hosting/src/
        - modules/billing-identity/src/
        - modules/billing-integrations/src/
        - modules/billing-invoicing/src/
        - modules/billing-isp/src/
        - modules/billing-licensing/src/
        - modules/billing-money/src/
        - modules/billing-orders/src/
        - modules/billing-payments/src/
        - modules/billing-pricing/src/
        - modules/billing-projects/src/
        - modules/billing-provisioning/src/
        - modules/billing-referrals/src/
        - modules/billing-reporting/src/
        - modules/billing-search/src/
        - modules/billing-settings/src/
        - modules/billing-subscriptions/src/
        - modules/billing-support/src/
        - modules/billing-usage/src/

    # Measured, not aspired to. This was 9 while CI ran phpstan never; app/ has
    # 5 errors at 9, 2 at 6, and none at 5. Level 5 is the first level this code
    # has ever actually met, and the ratchet is what moves it back up — the same
    # policy every package is now held to. The five level-9 errors are audit
    # findings, not a reason to keep a number nothing enforced.
    level: 5

    databaseMigrationsPath:
        - database/migrations
        - modules/billing-application/database/migrations
        - modules/billing-audit/database/migrations
        - modules/billing-catalog/database/migrations
        - modules/billing-collections/database/migrations
        - modules/billing-communications/database/migrations
        - modules/billing-customer-portal/database/migrations
        - modules/billing-domains/database/migrations
        - modules/billing-extensions/database/migrations
        - modules/billing-files/database/migrations
        - modules/billing-hosting/database/migrations
        - modules/billing-identity/database/migrations
        - modules/billing-integrations/database/migrations
        - modules/billing-invoicing/database/migrations
        - modules/billing-isp/database/migrations
        - modules/billing-licensing/database/migrations
        - modules/billing-money/database/migrations
        - modules/billing-orders/database/migrations
        - modules/billing-payments/database/migrations
        - modules/billing-pricing/database/migrations
        - modules/billing-projects/database/migrations
        - modules/billing-referrals/database/migrations
        - modules/billing-reporting/database/migrations
        - modules/billing-search/database/migrations
        - modules/billing-settings/database/migrations
        - modules/billing-subscriptions/database/migrations
        - modules/billing-support/database/migrations
        - modules/billing-usage/database/migrations
