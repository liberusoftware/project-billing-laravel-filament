{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "payment-square",
  "display_name": "Payment Square Adapter",
  "description": "Unified Square merchant payment adapter extending liberusoftware/payment-contracts.",
  "version": "1.0.0",
  "category": "adapter",
  "provider": "Liberu\\Payment\\Square\\SquarePaymentServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/payment-contracts": "^1.0"
    }
  },
  "capabilities": [
    "payments.gateway.square"
  ],
  "default_enabled": false,
  "features": [
    "Payment intents",
    "Captures & refunds",
    "Saved payment methods / mandates",
    "Signed webhook verification",
    "Disputes & settlement reconciliation"
  ]
}
