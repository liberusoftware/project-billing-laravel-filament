{
  "name": "liberusoftware/payment-square",
  "description": "Unified Square merchant payment adapter implementing liberusoftware/payment-contracts.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/payment-contracts": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Payment\\Square\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "payment-square"
    },
    "laravel": {
      "providers": [
        "Liberu\\Payment\\Square\\SquarePaymentServiceProvider"
      ]
    }
  }
}
