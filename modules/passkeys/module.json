{
  "$schema": "https://schemas.liberu.dev/module/v1.json",
  "name": "passkeys",
  "display_name": "Passkeys and WebAuthn",
  "description": "WebAuthn / FIDO2 passwordless authentication and cryptographic step-up verification.",
  "version": "1.0.1",
  "category": "foundation",
  "provider": "Liberu\\Passkeys\\PasskeysServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {}
  },
  "capabilities": [
    "identity.passkeys",
    "identity.step-up"
  ],
  "default_enabled": true,
  "features": [
    "WebAuthn registration ceremonies",
    "Discoverable credentials and passwordless sign-in",
    "Cryptographic step-up authentication",
    "Attestation and signature-counter clone detection",
    "Passkey lifecycle, naming, and revocation"
  ]
}
