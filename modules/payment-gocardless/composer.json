{
  "name": "liberusoftware/payment-gocardless",
  "description": "Unified GoCardless merchant payment adapter implementing liberusoftware/payment-contracts.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/http": "^13.0",
    "illuminate/support": "^13.0",
    "liberusoftware/payment-contracts": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Payment\\GoCardless\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "payment-gocardless"
    },
    "laravel": {
      "providers": [
        "Liberu\\Payment\\GoCardless\\GoCardlessPaymentServiceProvider"
      ]
    }
  }
}
