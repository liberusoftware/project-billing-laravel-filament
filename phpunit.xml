<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>modules/billing-*/tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>modules/billing-*/tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>modules/billing-application/tests/Architecture</directory>
        </testsuite>
        <testsuite name="Modules">
            <directory suffix="Test.php">modules/*/tests</directory>
            <exclude>modules/billing-*/tests</exclude>
            <exclude>modules/integrations/tests/Feature</exclude>
            <exclude>modules/organizations-teams/tests/Feature</exclude>
            <exclude>modules/roles-permissions/tests/Feature</exclude>
            <exclude>modules/scheduler-queues/tests/Feature</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>modules/*/src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:3xVFJ5tTr05dWL1gsJqF+UvWdv3X0Cz/CBaUG47hb3U="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
